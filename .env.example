# Backend Server Configuration (Lab 9.6)
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL / Aiven Cloud)
DB_ENGINE=django.db.backends.mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bookstore_db
DB_SSL_REQUIRED=false

# Security & Authentication
JWT_SECRET=
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOW_ALL=True

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
